<Project Sdk="Microsoft.NET.Sdk">
  <!--
    xISOBurn for Windows: the xISOBurn copy engine (multi-pass rescue, CSS, AACS/BD+) on a PC, with an
    internal or external (USB) optical drive. WinForms, .NET 10. Built and published by
    .github/workflows/build.yml as a single self-contained .exe (no .NET install needed).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>xISOBurn</RootNamespace>
    <AssemblyName>xISOBurn</AssemblyName>
    <ApplicationIcon>Assets\xISOBurn.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>xISOBurn</Product>
    <Description>Copies CDs, DVDs and Blu-ray discs to ISO images, sector by sector, with damaged-disc rescue.</Description>
    <Copyright>GPL-2.0-or-later</Copyright>
    <!-- The ported engine keeps its original style; do not drown the build in style warnings. -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0021;SYSLIB0022;SYSLIB0023</NoWarn>
    <EngineDir>$(MSBuildThisFileDirectory)..\..\xisoburn\engine\</EngineDir>
  </PropertyGroup>
  <!--
    The copy engine is shared with the Xbox app: it lives in rubinhos/xisoburn (engine/), included here
    as the git submodule "xisoburn". Clone with: git clone --recurse-submodules ...
  -->
  <ItemGroup>
    <Compile Include="$(EngineDir)**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CheckEngine" BeforeTargets="BeforeBuild" Condition="!Exists('$(EngineDir)Core\RescueJob.cs')">
    <Error Text="The shared engine is missing ($(EngineDir)). Run: git submodule update --init" />
  </Target>
</Project>
